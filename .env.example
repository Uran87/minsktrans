APP_PORT=8080

# Адрес внешнего REST API СНОиПД. Backend проксирует /api/v1/* и не сохраняет
# ситуационные данные. Для контейнера backend.
API_ORIGIN=http://194.158.195.62:41290

# Публичный путь API, который использует фронтенд (same-origin + nginx).
VITE_API_BASE=/api/v1

# true — при первом открытии включён демо-режим (маршрут №1).
# Переключатель в интерфейсе меняет режим без перезапуска.
VITE_MOCK_DEFAULT=true

# Только для локальной разработки: куда Vite проксирует /api.
# Запустите backend: npm run server
VITE_DEV_API_TARGET=http://localhost:3000

# --- Backend / сбор GPS и геометрии ---------------------------------------
# AUTO_BOOTSTRAP=true — при пустой базе сразу загрузить остановки, маршруты
# и расписания. JOBS_ENABLED=true — включить фоновые задачи.
AUTO_BOOTSTRAP=true
JOBS_ENABLED=true
# TRACE_INTERVAL_MS=60000
# TRACE_FOCUS_SIZE=8
# TRACE_FOCUS_HOURS=6
# TRACE_RETENTION_DAYS=14
