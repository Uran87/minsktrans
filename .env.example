APP_PORT=8080

# Адрес API, доступный из контейнера nginx.
API_ORIGIN=http://194.158.195.62:41290

# Публичный путь API, который использует фронтенд (same-origin + proxy).
VITE_API_BASE=/api/v1

# true — при первом открытии включён демо-режим (маршрут №1).
# Переключатель в интерфейсе меняет режим без перезапуска.
VITE_MOCK_DEFAULT=true

# Только для локальной разработки: куда Vite проксирует /api.
VITE_DEV_API_TARGET=http://194.158.195.62:41290
