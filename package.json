{
  "name": "minsktrans-live",
  "private": true,
  "version": "1.0.0",
  "description": "SPA-карта городского пассажирского транспорта Минска в реальном времени (OpenLayers + Vanilla JS + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node --env-file-if-exists=.env server/index.js",
    "worker": "node --env-file-if-exists=.env server/cli.js",
    "sync": "node --env-file-if-exists=.env server/cli.js bootstrap",
    "status": "node --env-file-if-exists=.env server/cli.js status",
    "seed:dev": "node server/dev-seed.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "ol": "^10.11.0"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
